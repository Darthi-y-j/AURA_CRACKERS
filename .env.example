VITE_SUPABASE_URL=https://fznaboorowrtrqrjnfuv.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Ollama chatbot (local AI assistant)
VITE_OLLAMA_ENABLED=true
# Use a smaller model for faster CPU replies: llama3.2:1b, phi3:mini, gemma2:2b
VITE_OLLAMA_MODEL=llama3.2:1b
VITE_OLLAMA_API_URL=/api/ollama
VITE_OLLAMA_MAX_TOKENS=45
VITE_OLLAMA_MAX_HISTORY=2
VITE_OLLAMA_NUM_CTX=1024
VITE_OLLAMA_NUM_THREAD=8
VITE_OLLAMA_KEEP_ALIVE=30m
# Fastest CPU model options: llama3.2:1b (default), qwen2.5:0.5b, phi3:mini

# RAG chatbot backend (FastAPI + ChromaDB) — proxied at /api/chatbot
VITE_CHATBOT_API=/api/chatbot
VITE_CHATBOT_RAG=true

# Groq cloud LLM (aura-chatbot backend — cheapest: llama-3.1-8b-instant)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
AURA_LLM_PROVIDER=groq
GROQ_MAX_TOKENS=100
GROQ_TEMPERATURE=0.15