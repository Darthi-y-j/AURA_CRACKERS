# Copy to aura-chatbot/.env — values can mirror the root .env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

OLLAMA_HOST=http://127.0.0.1:11434
AURA_LLM_MODEL=llama3.2:1b
AURA_EMBED_MODEL=nomic-embed-text

# Groq — cloud LLM (cheapest: llama-3.1-8b-instant ~$0.05/$0.08 per 1M tokens)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
AURA_LLM_PROVIDER=groq
GROQ_MAX_TOKENS=180
GROQ_TEMPERATURE=0.15

# FastAPI
AURA_CHATBOT_HOST=127.0.0.1
AURA_CHATBOT_PORT=8000
