{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "auracrackers.com"
        }
      ],
      "destination": "https://www.auracrackers.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.auracrackers.com/>; rel=\"canonical\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/)(?!.*\\..*$).*)",
      "destination": "/index.html"
    }
  ]
}
